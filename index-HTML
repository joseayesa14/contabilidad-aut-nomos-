<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contabilidad para Autónomos</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #e3f2fd 50%, #f3e5f5 100%);
            min-height: 100vh;
            padding: 2rem;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .header {
            margin-bottom: 2rem;
        }
        
        .header h1 {
            font-size: 2.5rem;
            color: #1e293b;
            margin-bottom: 0.5rem;
        }
        
        .header p {
            color: #64748b;
        }
        
        .nav {
            background: white;
            padding: 0.5rem;
            border-radius: 1rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            border: 2px solid #e2e8f0;
        }
        
        .nav button {
            flex: 1;
            padding: 0.75rem 1rem;
            border: none;
            border-radius: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            color: #64748b;
            background: transparent;
        }
        
        .nav button:hover {
            background: #f1f5f9;
        }
        
        .nav button.active {
            background: #3b82f6;
            color: white;
            box-shadow: 0 2px 4px rgba(59,130,246,0.3);
        }
        
        .card {
            background: white;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border: 2px solid #e2e8f0;
            margin-bottom: 1.5rem;
        }
        
        .card h3 {
            font-size: 1.5rem;
            color: #1e293b;
            margin-bottom: 1rem;
        }
        
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }
        
        .stat-card {
            padding: 1.5rem;
            border-radius: 1rem;
            color: white;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        .stat-card.green {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        }
        
        .stat-card.red {
            background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
        }
        
        .stat-card.blue {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
        }
        
        .stat-card .label {
            font-size: 0.875rem;
            opacity: 0.9;
            margin-bottom: 0.5rem;
        }
        
        .stat-card .value {
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 0.25rem;
        }
        
        .stat-card .sublabel {
            font-size: 0.875rem;
            opacity: 0.8;
        }
        
        .btn {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 0.5rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }
        
        .btn-primary {
            background: #3b82f6;
            color: white;
        }
        
        .btn-primary:hover {
            background: #2563eb;
        }
        
        .btn-success {
            background: #10b981;
            color: white;
        }
        
        .btn-success:hover {
            background: #059669;
        }
        
        .btn-danger {
            background: #f43f5e;
            color: white;
        }
        
        .btn-danger:hover {
            background: #e11d48;
        }
        
        .form-group {
            margin-bottom: 1rem;
        }
        
        .form-group label {
            display: block;
            font-weight: 600;
            color: #475569;
            margin-bottom: 0.5rem;
        }
        
        .form-group input,
        .form-group select {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid #e2e8f0;
            border-radius: 0.5rem;
            font-size: 1rem;
        }
        
        .form-group input:focus,
        .form-group select:focus {
            outline: none;
            border-color: #3b82f6;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
        }
        
        thead {
            background: #f1f5f9;
        }
        
        th {
            padding: 0.75rem;
            text-align: left;
            font-weight: 600;
            color: #475569;
            border-bottom: 2px solid #e2e8f0;
        }
        
        td {
            padding: 0.75rem;
            border-bottom: 1px solid #e2e8f0;
        }
        
        tbody tr:hover {
            background: #f8fafc;
        }
        
        .hidden {
            display: none;
        }
        
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        
        .text-right {
            text-align: right;
        }
        
        .text-center {
            text-align: center;
        }
        
        .badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 0.25rem;
            font-size: 0.75rem;
            font-weight: 600;
        }
        
        .badge-blue {
            background: #dbeafe;
            color: #1e40af;
        }
        
        .badge-green {
            background: #d1fae5;
            color: #065f46;
        }
        
        .badge-amber {
            background: #fef3c7;
            color: #92400e;
        }
        
        .footer {
            text-align: center;
            color: #64748b;
            margin-top: 2rem;
            font-size: 0.875rem;
        }
        
        .action-btns {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
        }
        
        .btn-small {
            padding: 0.5rem;
            font-size: 0.875rem;
        }
        
        .alert {
            padding: 1rem;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
        }
        
        .alert-info {
            background: #dbeafe;
            color: #1e40af;
            border: 1px solid #93c5fd;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>💼 Contabilidad para Autónomos</h1>
            <p>Gestiona tus ingresos, gastos y modelos trimestrales de forma sencilla</p>
        </div>
        
        <div class="nav">
            <button onclick="cambiarVista('dashboard')" id="btn-dashboard" class="active">📊 Dashboard</button>
            <button onclick="cambiarVista('ingresos')" id="btn-ingresos">📈 Ingresos</button>
            <button onclick="cambiarVista('gastos')" id="btn-gastos">💰 Gastos</button>
        </div>
        
        <!-- Dashboard -->
        <div id="vista-dashboard">
            <div class="card">
                <div class="grid-2" style="margin-bottom: 1rem; align-items: center;">
                    <h3 style="margin: 0;">Dashboard</h3>
                    <div style="text-align: right;">
                        <select id="trimestre" onchange="actualizarDashboard()" style="margin-right: 0.5rem; padding: 0.5rem;">
                            <option value="1">1º Trimestre</option>
                            <option value="2">2º Trimestre</option>
                            <option value="3">3º Trimestre</option>
                            <option value="4">4º Trimestre</option>
                        </select>
                        <select id="año" onchange="actualizarDashboard()" style="padding: 0.5rem;">
                            <option value="2024">2024</option>
                            <option value="2025">2025</option>
                            <option value="2026" selected>2026</option>
                            <option value="2027">2027</option>
                        </select>
                    </div>
                </div>
            </div>
            
            <div class="stats-grid">
                <div class="stat-card green">
                    <div class="label">Ingresos</div>
                    <div class="value" id="total-ingresos">0.00 €</div>
                    <div class="sublabel">Base imponible</div>
                </div>
                
                <div class="stat-card red">
                    <div class="label">Gastos</div>
                    <div class="value" id="total-gastos">0.00 €</div>
                    <div class="sublabel">Desgravables</div>
                </div>
                
                <div class="stat-card blue">
                    <div class="label">Beneficio Neto</div>
                    <div class="value" id="beneficio-neto">0.00 €</div>
                    <div class="sublabel">Rendimiento neto</div>
                </div>
            </div>
            
            <div class="grid-2">
                <div class="card">
                    <h3>📄 Modelo 130 - IRPF</h3>
                    <table>
                        <tr>
                            <td>Ingresos computables</td>
                            <td class="text-right" id="m130-ingresos">0.00 €</td>
                        </tr>
                        <tr>
                            <td>Gastos deducibles</td>
                            <td class="text-right" style="color: #f43f5e;" id="m130-gastos">-0.00 €</td>
                        </tr>
                        <tr style="font-weight: bold; border-top: 2px solid #e2e8f0;">
                            <td>Rendimiento neto</td>
                            <td class="text-right" id="m130-rendimiento">0.00 €</td>
                        </tr>
                        <tr style="background: #fef3c7;">
                            <td style="font-weight: bold;">Pago fraccionado (20%)</td>
                            <td class="text-right" style="font-weight: bold; color: #92400e; font-size: 1.25rem;" id="m130-pago">0.00 €</td>
                        </tr>
                    </table>
                </div>
                
                <div class="card">
                    <h3>📄 Modelo 303 - IVA</h3>
                    <table>
                        <tr>
                            <td>IVA repercutido (ventas)</td>
                            <td class="text-right" id="m303-repercutido">0.00 €</td>
                        </tr>
                        <tr>
                            <td>IVA soportado (gastos)</td>
                            <td class="text-right" style="color: #10b981;" id="m303-soportado">-0.00 €</td>
                        </tr>
                        <tr style="background: #f3e8ff;">
                            <td style="font-weight: bold;" id="m303-label">A ingresar</td>
                            <td class="text-right" style="font-weight: bold; font-size: 1.25rem;" id="m303-diferencia">0.00 €</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Ingresos -->
        <div id="vista-ingresos" class="hidden">
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h3 style="margin: 0;">Ingresos</h3>
                    <button class="btn btn-success" onclick="mostrarFormIngreso()">➕ Nuevo Ingreso</button>
                </div>
                
                <div id="form-ingreso" class="hidden" style="margin-bottom: 1.5rem;">
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Fecha</label>
                            <input type="date" id="ingreso-fecha">
                        </div>
                        <div class="form-group">
                            <label>Concepto</label>
                            <input type="text" id="ingreso-concepto" placeholder="Servicios profesionales">
                        </div>
                    </div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Base Imponible (€)</label>
                            <input type="number" step="0.01" id="ingreso-base" oninput="calcularIVAIngreso()" placeholder="1000.00">
                        </div>
                        <div class="form-group">
                            <label>IVA (21%) (€)</label>
                            <input type="number" step="0.01" id="ingreso-iva" oninput="calcularTotalIngreso()" placeholder="210.00">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Total (€)</label>
                        <input type="number" step="0.01" id="ingreso-total" readonly style="background: #f1f5f9; font-weight: bold; font-size: 1.125rem;">
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                        <button class="btn btn-primary" onclick="guardarIngreso()">✓ Guardar</button>
                        <button class="btn" style="background: #e2e8f0;" onclick="cancelarFormIngreso()">✕ Cancelar</button>
                    </div>
                </div>
                
                <table>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Concepto</th>
                            <th class="text-right">Base</th>
                            <th class="text-right">IVA</th>
                            <th class="text-right">Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-ingresos">
                        <tr>
                            <td colspan="6" class="text-center" style="padding: 2rem; color: #64748b;">
                                No hay ingresos registrados. Agrega tu primer ingreso.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Gastos -->
        <div id="vista-gastos" class="hidden">
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h3 style="margin: 0;">Gastos</h3>
                    <button class="btn btn-danger" onclick="mostrarFormGasto()">➕ Nuevo Gasto</button>
                </div>
                
                <div id="form-gasto" class="hidden" style="margin-bottom: 1.5rem;">
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Fecha</label>
                            <input type="date" id="gasto-fecha">
                        </div>
                        <div class="form-group">
                            <label>Categoría</label>
                            <select id="gasto-categoria" onchange="actualizarInfoDesgravacion()">
                                <option value="100">Material oficina (100%)</option>
                                <option value="30">Suministros - luz, agua, internet (30%)</option>
                                <option value="100b">Alquiler oficina (100%)</option>
                                <option value="50">Telefonía móvil (50%)</option>
                                <option value="100c">Seguro responsabilidad civil (100%)</option>
                                <option value="100d">Cuota autónomo (100%)</option>
                                <option value="100e">Formación profesional (100%)</option>
                                <option value="100f">Gastos financieros (100%)</option>
                                <option value="50b">Vehículo - combustible (50%)</option>
                                <option value="100g">Comidas clientes (100%)</option>
                                <option value="100h">Software y licencias (100%)</option>
                                <option value="100i">Publicidad y marketing (100%)</option>
                                <option value="100j">Gestoría (100%)</option>
                                <option value="0">Otros gastos (0%)</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Concepto</label>
                        <input type="text" id="gasto-concepto" placeholder="Descripción del gasto">
                    </div>
                    <div class="grid-2">
                        <div class="form-group">
                            <label>Base Imponible (€)</label>
                            <input type="number" step="0.01" id="gasto-base" oninput="calcularIVAGasto()" placeholder="50.00">
                        </div>
                        <div class="form-group">
                            <label>IVA (21%) (€)</label>
                            <input type="number" step="0.01" id="gasto-iva" oninput="calcularTotalGasto()" placeholder="10.50">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Total (€)</label>
                        <input type="number" step="0.01" id="gasto-total" readonly style="background: #f1f5f9; font-weight: bold; font-size: 1.125rem;">
                    </div>
                    <div class="alert alert-info" id="info-desgravacion">
                        <strong>Desgravación: 100%</strong><br>
                        <span id="desgrav-detalle">100% desgravable</span>
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                        <button class="btn btn-primary" onclick="guardarGasto()">✓ Guardar</button>
                        <button class="btn" style="background: #e2e8f0;" onclick="cancelarFormGasto()">✕ Cancelar</button>
                    </div>
                </div>
                
                <table>
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Categoría</th>
                            <th>Concepto</th>
                            <th class="text-right">Base</th>
                            <th class="text-right">IVA</th>
                            <th class="text-right">Total</th>
                            <th class="text-center">Desgrav.</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tabla-gastos">
                        <tr>
                            <td colspan="8" class="text-center" style="padding: 2rem; color: #64748b;">
                                No hay gastos registrados. Agrega tu primer gasto.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div class="card" style="background: linear-gradient(135deg, #eff6ff 0%, #f3e8ff 100%);">
                <h3>💡 Guía de Desgravación</h3>
                <div class="grid-2">
                    <div style="background: white; padding: 1rem; border-radius: 0.5rem;">
                        <div style="font-weight: bold; color: #059669; margin-bottom: 0.5rem;">100% Desgravable</div>
                        <div style="color: #475569; font-size: 0.875rem;">Material oficina, software, formación, gestoría, alquiler oficina</div>
                    </div>
                    <div style="background: white; padding: 1rem; border-radius: 0.5rem;">
                        <div style="font-weight: bold; color: #d97706; margin-bottom: 0.5rem;">30-50% Desgravable</div>
                        <div style="color: #475569; font-size: 0.875rem;">Suministros, telefonía móvil, vehículo (uso mixto)</div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="footer">
            <p>Datos guardados automáticamente en tu navegador</p>
            <p style="margin-top: 0.5rem;"><strong>Importante:</strong> Consulta con tu gestor fiscal para validar los cálculos</p>
        </div>
    </div>
    
    <script>
        // Datos
        let ingresos = [];
        let gastos = [];
        
        // Cargar datos
        function cargarDatos() {
            const ingresosGuardados = localStorage.getItem('ingresos-autonomo');
            const gastosGuardados = localStorage.getItem('gastos-autonomo');
            
            if (ingresosGuardados) ingresos = JSON.parse(ingresosGuardados);
            if (gastosGuardados) gastos = JSON.parse(gastosGuardados);
            
            actualizarDashboard();
            renderizarIngresos();
            renderizarGastos();
        }
        
        // Guardar datos
        function guardarDatos() {
            localStorage.setItem('ingresos-autonomo', JSON.stringify(ingresos));
            localStorage.setItem('gastos-autonomo', JSON.stringify(gastos));
        }
        
        // Cambiar vista
        function cambiarVista(vista) {
            document.querySelectorAll('.nav button').forEach(btn => btn.classList.remove('active'));
            document.getElementById('btn-' + vista).classList.add('active');
            
            document.getElementById('vista-dashboard').classList.add('hidden');
            document.getElementById('vista-ingresos').classList.add('hidden');
            document.getElementById('vista-gastos').classList.add('hidden');
            
            document.getElementById('vista-' + vista).classList.remove('hidden');
        }
        
        // Ingresos
        function mostrarFormIngreso() {
            document.getElementById('form-ingreso').classList.remove('hidden');
            document.getElementById('ingreso-fecha').value = new Date().toISOString().split('T')[0];
        }
        
        function cancelarFormIngreso() {
            document.getElementById('form-ingreso').classList.add('hidden');
            limpiarFormIngreso();
        }
        
        function limpiarFormIngreso() {
            document.getElementById('ingreso-concepto').value = '';
            document.getElementById('ingreso-base').value = '';
            document.getElementById('ingreso-iva').value = '';
            document.getElementById('ingreso-total').value = '';
        }
        
        function calcularIVAIngreso() {
            const base = parseFloat(document.getElementById('ingreso-base').value) || 0;
            const iva = (base * 0.21).toFixed(2);
            document.getElementById('ingreso-iva').value = iva;
            calcularTotalIngreso();
        }
        
        function calcularTotalIngreso() {
            const base = parseFloat(document.getElementById('ingreso-base').value) || 0;
            const iva = parseFloat(document.getElementById('ingreso-iva').value) || 0;
            document.getElementById('ingreso-total').value = (base + iva).toFixed(2);
        }
        
        function guardarIngreso() {
            const fecha = document.getElementById('ingreso-fecha').value;
            const concepto = document.getElementById('ingreso-concepto').value;
            const base = parseFloat(document.getElementById('ingreso-base').value) || 0;
            const iva = parseFloat(document.getElementById('ingreso-iva').value) || 0;
            const total = parseFloat(document.getElementById('ingreso-total').value) || 0;
            
            if (!fecha || !concepto || base === 0) {
                alert('Por favor completa todos los campos');
                return;
            }
            
            ingresos.push({
                id: Date.now(),
                fecha,
                concepto,
                baseImponible: base,
                iva,
                total
            });
            
            guardarDatos();
            renderizarIngresos();
            actualizarDashboard();
            cancelarFormIngreso();
        }
        
        function eliminarIngreso(id) {
            if (confirm('¿Eliminar este ingreso?')) {
                ingresos = ingresos.filter(i => i.id !== id);
                guardarDatos();
                renderizarIngresos();
                actualizarDashboard();
            }
        }
        
        function renderizarIngresos() {
            const tbody = document.getElementById('tabla-ingresos');
            
            if (ingresos.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center" style="padding: 2rem; color: #64748b;">No hay ingresos registrados.</td></tr>';
                return;
            }
            
            tbody.innerHTML = ingresos.map(ing => `
                <tr>
                    <td>${ing.fecha}</td>
                    <td>${ing.concepto}</td>
                    <td class="text-right">${ing.baseImponible.toFixed(2)} €</td>
                    <td class="text-right">${ing.iva.toFixed(2)} €</td>
                    <td class="text-right" style="font-weight: bold; color: #10b981;">${ing.total.toFixed(2)} €</td>
                    <td class="text-center">
                        <button class="btn btn-small btn-danger" onclick="eliminarIngreso(${ing.id})">🗑️</button>
                    </td>
                </tr>
            `).join('');
        }
        
        // Gastos
        function mostrarFormGasto() {
            document.getElementById('form-gasto').classList.remove('hidden');
            document.getElementById('gasto-fecha').value = new Date().toISOString().split('T')[0];
            actualizarInfoDesgravacion();
        }
        
        function cancelarFormGasto() {
            document.getElementById('form-gasto').classList.add('hidden');
            limpiarFormGasto();
        }
        
        function limpiarFormGasto() {
            document.getElementById('gasto-concepto').value = '';
            document.getElementById('gasto-base').value = '';
            document.getElementById('gasto-iva').value = '';
            document.getElementById('gasto-total').value = '';
        }
        
        function calcularIVAGasto() {
            const base = parseFloat(document.getElementById('gasto-base').value) || 0;
            const iva = (base * 0.21).toFixed(2);
            document.getElementById('gasto-iva').value = iva;
            calcularTotalGasto();
            actualizarInfoDesgravacion();
        }
        
        function calcularTotalGasto() {
            const base = parseFloat(document.getElementById('gasto-base').value) || 0;
            const iva = parseFloat(document.getElementById('gasto-iva').value) || 0;
            document.getElementById('gasto-total').value = (base + iva).toFixed(2);
            actualizarInfoDesgravacion();
        }
        
        function obtenerPorcentaje(valor) {
            return parseInt(valor) || 0;
        }
        
        function actualizarInfoDesgravacion() {
            const cat = document.getElementById('gasto-categoria').value;
            const porcentaje = obtenerPorcentaje(cat);
            const base = parseFloat(document.getElementById('gasto-base').value) || 0;
            const iva = parseFloat(document.getElementById('gasto-iva').value) || 0;
            
            const baseDesgrav = (base * porcentaje / 100).toFixed(2);
            const ivaDesgrav = (iva * porcentaje / 100).toFixed(2);
            
            document.getElementById('desgrav-detalle').innerHTML = 
                `${porcentaje}% desgravable${base > 0 ? `<br>Importe desgravable: ${baseDesgrav} € (IVA: ${ivaDesgrav} €)` : ''}`;
        }
        
        function guardarGasto() {
            const fecha = document.getElementById('gasto-fecha').value;
            const categoria = document.getElementById('gasto-categoria').selectedOptions[0].text;
            const concepto = document.getElementById('gasto-concepto').value;
            const base = parseFloat(document.getElementById('gasto-base').value) || 0;
            const iva = parseFloat(document.getElementById('gasto-iva').value) || 0;
            const total = parseFloat(document.getElementById('gasto-total').value) || 0;
            const porcentaje = obtenerPorcentaje(document.getElementById('gasto-categoria').value);
            
            if (!fecha || !concepto || base === 0) {
                alert('Por favor completa todos los campos');
                return;
            }
            
            gastos.push({
                id: Date.now(),
                fecha,
                categoria,
                concepto,
                baseImponible: base,
                iva,
                total,
                porcentajeDesgravable: porcentaje,
                baseDesgravable: base * porcentaje / 100,
                ivaDesgravable: iva * porcentaje / 100
            });
            
            guardarDatos();
            renderizarGastos();
            actualizarDashboard();
            cancelarFormGasto();
        }
        
        function eliminarGasto(id) {
            if (confirm('¿Eliminar este gasto?')) {
                gastos = gastos.filter(g => g.id !== id);
                guardarDatos();
                renderizarGastos();
                actualizarDashboard();
            }
        }
        
        function renderizarGastos() {
            const tbody = document.getElementById('tabla-gastos');
            
            if (gastos.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center" style="padding: 2rem; color: #64748b;">No hay gastos registrados.</td></tr>';
                return;
            }
            
            tbody.innerHTML = gastos.map(gasto => {
                let badgeClass = 'badge-blue';
                if (gasto.porcentajeDesgravable === 100) badgeClass = 'badge-green';
                else if (gasto.porcentajeDesgravable === 0) badgeClass = '';
                else badgeClass = 'badge-amber';
                
                return `
                    <tr>
                        <td>${gasto.fecha}</td>
                        <td><span class="badge badge-blue">${gasto.categoria}</span></td>
                        <td>${gasto.concepto}</td>
                        <td class="text-right">${gasto.baseImponible.toFixed(2)} €</td>
                        <td class="text-right">${gasto.iva.toFixed(2)} €</td>
                        <td class="text-right">${gasto.total.toFixed(2)} €</td>
                        <td class="text-center"><span class="badge ${badgeClass}">${gasto.porcentajeDesgravable}%</span></td>
                        <td class="text-center">
                            <button class="btn btn-small btn-danger" onclick="eliminarGasto(${gasto.id})">🗑️</button>
                        </td>
                    </tr>
                `;
            }).join('');
        }
        
        // Dashboard
        function actualizarDashboard() {
            const trimestre = parseInt(document.getElementById('trimestre').value);
            const año = parseInt(document.getElementById('año').value);
            
            const mesesTrimestre = {
                1: [0, 1, 2],
                2: [3, 4, 5],
                3: [6, 7, 8],
                4: [9, 10, 11]
            };
            
            const filtrar = (items) => items.filter(item => {
                const fecha = new Date(item.fecha);
                return fecha.getFullYear() === año && 
                       mesesTrimestre[trimestre].includes(fecha.getMonth());
            });
            
            const ingresosT = filtrar(ingresos);
            const gastosT = filtrar(gastos);
            
            const totalIngresos = ingresosT.reduce((sum, i) => sum + i.baseImponible, 0);
            const totalGastos = gastosT.reduce((sum, g) => sum + g.baseDesgravable, 0);
            const ivaRepercutido = ingresosT.reduce((sum, i) => sum + i.iva, 0);
            const ivaSoportado = gastosT.reduce((sum, g) => sum + g.ivaDesgravable, 0);
            
            const rendimientoNeto = totalIngresos - totalGastos;
            const ivaDiferencia = ivaRepercutido - ivaSoportado;
            const pagoFraccionado = Math.max(0, rendimientoNeto * 0.20);
            
            // Actualizar tarjetas
            document.getElementById('total-ingresos').textContent = totalIngresos.toFixed(2) + ' €';
            document.getElementById('total-gastos').textContent = totalGastos.toFixed(2) + ' €';
            document.getElementById('beneficio-neto').textContent = rendimientoNeto.toFixed(2) + ' €';
            
            // Modelo 130
            document.getElementById('m130-ingresos').textContent = totalIngresos.toFixed(2) + ' €';
            document.getElementById('m130-gastos').textContent = '-' + totalGastos.toFixed(2) + ' €';
            document.getElementById('m130-rendimiento').textContent = rendimientoNeto.toFixed(2) + ' €';
            document.getElementById('m130-pago').textContent = pagoFraccionado.toFixed(2) + ' €';
            
            // Modelo 303
            document.getElementById('m303-repercutido').textContent = ivaRepercutido.toFixed(2) + ' €';
            document.getElementById('m303-soportado').textContent = '-' + ivaSoportado.toFixed(2) + ' €';
            document.getElementById('m303-diferencia').textContent = Math.abs(ivaDiferencia).toFixed(2) + ' €';
            document.getElementById('m303-label').textContent = ivaDiferencia >= 0 ? 'A ingresar' : 'A devolver';
            document.getElementById('m303-diferencia').style.color = ivaDiferencia >= 0 ? '#7c2d12' : '#065f46';
        }
        
        // Inicializar
        window.onload = () => {
            cargarDatos();
        };
    </script>
</body>
</html>
